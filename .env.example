# Copiar como .env.local (local) y cargar las mismas variables en
# Vercel -> Settings -> Environment Variables. NUNCA subir valores reales.

# Supabase -> Settings -> API Keys
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXX

# PIN del botón "Reiniciar" de la web (mínimo 8 caracteres; mejor una frase)
ADMIN_PIN=cambia-esta-frase

# Solo para supabase/respaldo.ps1 (no se carga en Vercel)
# Supabase -> Connect -> Session pooler
SUPABASE_DB_URL=postgresql://postgres.TU_PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
